# Configuración web de tu proyecto Firebase (Consola → Configuración del proyecto → Tus apps).
# Son identificadores públicos de la app web, no secretos. Nunca pongas aquí claves de servidor.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = usar los emuladores locales (npm run emulators) en lugar de un proyecto real.
VITE_USE_FIREBASE_EMULATORS=false
